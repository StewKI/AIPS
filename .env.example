# Local development only, these values are throwaway.
# The VPS deployment uses deploy/.env.example

POSTGRES_DB=aips_db
POSTGRES_USER=aips_user
POSTGRES_PASSWORD=aips_dev_password
DB_CONN_STRING=Host=localhost;Port=5432;Database=aips_db;Username=aips_user;Password=aips_dev_password

RABBITMQ_DEFAULT_USER=aips_rabbit
RABBITMQ_DEFAULT_PASS=aips_dev_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_URI=amqp://aips_rabbit:aips_dev_password@localhost:5672/%2F
RABBITMQ_EXCHANGE=aips

JWT_ISSUER=AIPS
JWT_AUDIENCE=AIPSWebApi
JWT_KEY=local_dev_signing_key_replace_this_before_you_deploy_anywhere
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
